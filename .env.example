# Copy this file to .env and fill in real values. .env, .env.local and
# .env.dev are all gitignored — never commit real credentials.
#
# TEST_ENV picks local vs dev vs uat at run time (see src/config/env.ts).
# You normally don't set it here — the npm scripts set it per run, e.g.:
#   npm run test:crm         -> TEST_ENV=local (default)
#   npm run test:crm:dev     -> TEST_ENV=dev
#   npm run test:techpack:uat -> TEST_ENV=uat
TEST_ENV=local

# ─────────────────────────────────────────────────────────────────────
# app-shell target — every module is mounted under this one shell
# (see src/config/modules.ts). Local defaults to the shell's Vite dev
# port from `tilt up` in the floorOS repo, so LOCAL_APP_SHELL_URL is
# usually fine unset. DEV_APP_SHELL_URL/UAT_APP_SHELL_URL have no
# default and are required once you run anything with TEST_ENV=dev /
# TEST_ENV=uat respectively.
# ─────────────────────────────────────────────────────────────────────
LOCAL_APP_SHELL_URL=http://localhost:3100
DEV_APP_SHELL_URL=https://dev.flooros.app
UAT_APP_SHELL_URL=https://uat.flooros.app

# ─────────────────────────────────────────────────────────────────────
# Per-module test users — each module logs in as its own seeded
# Keycloak user (floorOS keycloak/floorOS-dev-realm.json for local; ask
# your lead for the dev-realm equivalents). Only fill in the module(s)
# you own; the framework only reads the module you're running.
# ─────────────────────────────────────────────────────────────────────

# CRM
CRM_USER_LOCAL= alice
CRM_PASSWORD_LOCAL= password
CRM_USER_DEV=
CRM_PASSWORD_DEV=

# CRM — second identity for the Biz Doc RBAC negative test (TC:5): a
# seeded `job.crm-executive` user (crm.access only, no crm.manage), which
# `crm:biz-docs:read` requires (services/svc-authz/migrations/
# 1800000000060_crm_biz_docs_manager_only_and_page_keys.sql). Quote the
# password if it contains a `#` — dotenv otherwise treats it as a comment.
CRM_EXECUTIVE_USER_LOCAL=
CRM_EXECUTIVE_PASSWORD_LOCAL=

# Fabric Mill
MILL_USER_LOCAL=
MILL_PASSWORD_LOCAL=
# Dev login (works on both dev.flooros.app and devmill.flooros.app). The
# repo is public, so the login is never committed — get both
# MILL_USER_DEV and MILL_PASSWORD_DEV from the Mill QA (Jayashri) or the
# team's password store and paste them into your own .env.
MILL_USER_DEV=
MILL_PASSWORD_DEV=
# Optional: the mill CR round is deployed to its own dev instance. When
# set, every Mill project (login, smoke, sanity, regression) runs against
# it instead of DEV_APP_SHELL_URL; other modules are unaffected. The same
# MILL_USER_DEV / MILL_PASSWORD_DEV login works there.
MILL_DEV_APP_SHELL_URL=https://devmill.flooros.app

# Costing
COSTING_USER_LOCAL=
COSTING_PASSWORD_LOCAL=
COSTING_USER_DEV=
COSTING_PASSWORD_DEV=

# Planning
PLANNING_USER_LOCAL=
PLANNING_PASSWORD_LOCAL=
PLANNING_USER_DEV=
PLANNING_PASSWORD_DEV=

# Planning — extra logins for the regression suite's permission cases.
# READONLY: can read the Planning masters but not write them (e.g. a user
# holding only job.pln-viewer). NOACCESS: can't open the Planning masters
# (Activities, Difficulty grades, Recipes) at all. Cases skip when blank.
PLANNING_READONLY_USER_DEV=
PLANNING_READONLY_PASSWORD_DEV=
PLANNING_NOACCESS_USER_DEV=
PLANNING_NOACCESS_PASSWORD_DEV=

# Techpack
TECHPACK_USER_LOCAL=
TECHPACK_PASSWORD_LOCAL=
TECHPACK_USER_DEV=
TECHPACK_PASSWORD_DEV=
TECHPACK_USER_UAT=
TECHPACK_PASSWORD_UAT=

# Techpack — second, non-admin user for the multi-user presence and
# Validation Rules permission cases (a Qc-lead account, e.g. `bob`, which
# works on both dev and uat). Tests that need it skip when these are blank.
TECHPACK_SECOND_USER_DEV=
TECHPACK_SECOND_PASSWORD_DEV=
TECHPACK_SECOND_USER_UAT=
TECHPACK_SECOND_PASSWORD_UAT=

# BOM
BOM_USER_LOCAL=
BOM_PASSWORD_LOCAL=
BOM_USER_DEV=
BOM_PASSWORD_DEV=
BOM_USER_UAT=
BOM_PASSWORD_UAT=

# BOM — second, non-admin user for the BOM permission cases (a Qc-lead
# account, e.g. `bob`). Tests that need it skip when these are blank.
BOM_SECOND_USER_DEV=
BOM_SECOND_PASSWORD_DEV=
BOM_SECOND_USER_UAT=
BOM_SECOND_PASSWORD_UAT=

# Sample Development
SAMPLE_DEVELOPMENT_USER_LOCAL=
SAMPLE_DEVELOPMENT_PASSWORD_LOCAL=
SAMPLE_DEVELOPMENT_USER_DEV=
SAMPLE_DEVELOPMENT_PASSWORD_DEV=

# Master Data
MASTER_DATA_USER_LOCAL=
MASTER_DATA_PASSWORD_LOCAL=
MASTER_DATA_USER_DEV=
MASTER_DATA_PASSWORD_DEV=
