# Copy this file to .env and fill in real values. .env, .env.local and
# .env.dev are all gitignored — never commit real credentials.
#
# TEST_ENV picks local vs dev at run time (see src/config/env.ts). You
# normally don't set it here — the npm scripts set it per run, e.g.:
#   npm run test:crm         -> TEST_ENV=local (default)
#   npm run test:crm:dev     -> TEST_ENV=dev
TEST_ENV=local

# ─────────────────────────────────────────────────────────────────────
# app-shell target — every module is mounted under this one shell
# (see src/config/modules.ts). Local defaults to the shell's Vite dev
# port from `tilt up` in the floorOS repo, so LOCAL_APP_SHELL_URL is
# usually fine unset. DEV_APP_SHELL_URL has no default and is required
# once you run anything with TEST_ENV=dev.
# ─────────────────────────────────────────────────────────────────────
LOCAL_APP_SHELL_URL=http://localhost:3100
DEV_APP_SHELL_URL=https://dev.flooros.app

# ─────────────────────────────────────────────────────────────────────
# Per-module test users — each module logs in as its own seeded
# Keycloak user (floorOS keycloak/floorOS-dev-realm.json for local; ask
# your lead for the dev-realm equivalents). Only fill in the module(s)
# you own; the framework only reads the module you're running.
# ─────────────────────────────────────────────────────────────────────

# CRM
CRM_USER_LOCAL= alice
CRM_PASSWORD_LOCAL= password
CRM_USER_DEV=
CRM_PASSWORD_DEV=

# CRM — second identity for the Biz Doc RBAC negative test (TC:5): a
# seeded `job.crm-executive` user (crm.access only, no crm.manage), which
# `crm:biz-docs:read` requires (services/svc-authz/migrations/
# 1800000000060_crm_biz_docs_manager_only_and_page_keys.sql). Quote the
# password if it contains a `#` — dotenv otherwise treats it as a comment.
CRM_EXECUTIVE_USER_LOCAL=
CRM_EXECUTIVE_PASSWORD_LOCAL=

# Fabric Mill
MILL_USER_LOCAL=
MILL_PASSWORD_LOCAL=
MILL_USER_DEV=
MILL_PASSWORD_DEV=

# Costing
COSTING_USER_LOCAL=
COSTING_PASSWORD_LOCAL=
COSTING_USER_DEV=
COSTING_PASSWORD_DEV=

# Planning
PLANNING_USER_LOCAL=
PLANNING_PASSWORD_LOCAL=
PLANNING_USER_DEV=
PLANNING_PASSWORD_DEV=

# Techpack
TECHPACK_USER_LOCAL=
TECHPACK_PASSWORD_LOCAL=
TECHPACK_USER_DEV=
TECHPACK_PASSWORD_DEV=

# Master Data
MASTER_DATA_USER_LOCAL=
MASTER_DATA_PASSWORD_LOCAL=
MASTER_DATA_USER_DEV=
MASTER_DATA_PASSWORD_DEV=

# Admin
ADMIN_USER_LOCAL=
ADMIN_PASSWORD_LOCAL=
ADMIN_USER_DEV=
ADMIN_PASSWORD_DEV=

# Copilot
COPILOT_USER_LOCAL=
COPILOT_PASSWORD_LOCAL=
COPILOT_USER_DEV=
COPILOT_PASSWORD_DEV=
