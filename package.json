{
  "name": "pw-hybrid-framework",
  "version": "1.0.0",
  "description": "floorOS QA automation framework: TypeScript + Playwright Test + POM, organized one module per QA (CRM, MILL, ...), runnable against local or dev.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/saitex-ai/Floor-OS-Test-Automation.git"
  },
  "scripts": {
    "test:local": "playwright test",
    "test:dev": "TEST_ENV=dev playwright test",
    "test:crm": "playwright test --project=crm",
    "test:crm:dev": "TEST_ENV=dev playwright test --project=crm",
    "test:crm:ordered": "playwright test --project=crm --workers=1",
    "test:crm:ordered:dev": "TEST_ENV=dev playwright test --project=crm --workers=1",
    "test:mill": "playwright test --project=mill",
    "test:mill:dev": "TEST_ENV=dev playwright test --project=mill",
    "test:costing": "playwright test --project=costing",
    "test:costing:dev": "TEST_ENV=dev playwright test --project=costing",
    "test:planning": "playwright test --project=planning",
    "test:planning:dev": "TEST_ENV=dev playwright test --project=planning",
    "test:techpack": "playwright test --project=techpack",
    "test:techpack:dev": "TEST_ENV=dev playwright test --project=techpack",
    "test:master-data": "playwright test --project=master-data",
    "test:master-data:dev": "TEST_ENV=dev playwright test --project=master-data",
    "test:admin": "playwright test --project=admin",
    "test:admin:dev": "TEST_ENV=dev playwright test --project=admin",
    "test:copilot": "playwright test --project=copilot",
    "test:copilot:dev": "TEST_ENV=dev playwright test --project=copilot",
    "test:sanity": "playwright test --project=sanity-crm --project=sanity-mill --project=sanity-costing --project=sanity-planning --project=sanity-techpack --project=sanity-master-data",
    "test:sanity:dev": "TEST_ENV=dev playwright test --project=sanity-crm --project=sanity-mill --project=sanity-costing --project=sanity-planning --project=sanity-techpack --project=sanity-master-data",
    "test:sanity:crm": "playwright test --project=sanity-crm",
    "test:sanity:crm:dev": "TEST_ENV=dev playwright test --project=sanity-crm",
    "test:sanity:mill": "playwright test --project=sanity-mill",
    "test:sanity:mill:dev": "TEST_ENV=dev playwright test --project=sanity-mill",
    "test:sanity:costing": "playwright test --project=sanity-costing",
    "test:sanity:costing:dev": "TEST_ENV=dev playwright test --project=sanity-costing",
    "test:sanity:planning": "playwright test --project=sanity-planning",
    "test:sanity:planning:dev": "TEST_ENV=dev playwright test --project=sanity-planning",
    "test:sanity:techpack": "playwright test --project=sanity-techpack",
    "test:sanity:techpack:dev": "TEST_ENV=dev playwright test --project=sanity-techpack",
    "test:sanity:master-data": "playwright test --project=sanity-master-data",
    "test:sanity:master-data:dev": "TEST_ENV=dev playwright test --project=sanity-master-data",
    "test:smoke": "playwright test --project=smoke-crm --project=smoke-mill --project=smoke-costing --project=smoke-planning --project=smoke-techpack --project=smoke-master-data --project=smoke-admin --project=smoke-copilot",
    "test:smoke:dev": "TEST_ENV=dev playwright test --project=smoke-crm --project=smoke-mill --project=smoke-costing --project=smoke-planning --project=smoke-techpack --project=smoke-master-data --project=smoke-admin --project=smoke-copilot",
    "test:smoke:crm": "playwright test --project=smoke-crm",
    "test:smoke:crm:dev": "TEST_ENV=dev playwright test --project=smoke-crm",
    "test:smoke:mill": "playwright test --project=smoke-mill",
    "test:smoke:mill:dev": "TEST_ENV=dev playwright test --project=smoke-mill",
    "test:smoke:costing": "playwright test --project=smoke-costing",
    "test:smoke:costing:dev": "TEST_ENV=dev playwright test --project=smoke-costing",
    "test:smoke:planning": "playwright test --project=smoke-planning",
    "test:smoke:planning:dev": "TEST_ENV=dev playwright test --project=smoke-planning",
    "test:smoke:techpack": "playwright test --project=smoke-techpack",
    "test:smoke:techpack:dev": "TEST_ENV=dev playwright test --project=smoke-techpack",
    "test:smoke:master-data": "playwright test --project=smoke-master-data",
    "test:smoke:master-data:dev": "TEST_ENV=dev playwright test --project=smoke-master-data",
    "test:smoke:admin": "playwright test --project=smoke-admin",
    "test:smoke:admin:dev": "TEST_ENV=dev playwright test --project=smoke-admin",
    "test:smoke:copilot": "playwright test --project=smoke-copilot",
    "test:smoke:copilot:dev": "TEST_ENV=dev playwright test --project=smoke-copilot",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "report:allure:generate": "rm -rf allure-report && allure generate allure-results --output allure-report",
    "report:allure:open": "allure open allure-report",
    "install:browsers": "playwright install --with-deps",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "allure": "^3.16.0",
    "allure-playwright": "^3.11.1",
    "dotenv": "^16.4.5",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0"
  }
}
